---
/**
 * NavBar — top navigation bar for the KeelHq landing page.
 *
 * Responsibility:
 * - Render the KeelHq logo/wordmark and a "Join Waitlist" CTA.
 * - Stay sticky with a frosted-glass background.
 */

---

<header class="navbar" role="banner">
  <nav class="navbar__inner" aria-label="Main navigation">
    <a href="/" class="navbar__brand" aria-label="KeelHq home">
      <img
        class="navbar__logo"
        src="/logo.ico"
        alt=""
        width="28"
        height="28"
        aria-hidden="true"
      />
      <span class="navbar__wordmark">KeelHq</span>
    </a>

    <a href="#waitlist" class="navbar__cta" aria-label="Join the KeelHq waitlist">
      Join Waitlist
    </a>
  </nav>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: rgba(235, 233, 228, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
  }

  .navbar__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-lg);
    text-decoration: none;
  }

  .navbar__logo {
    display: block;
    flex-shrink: 0;
    object-fit: contain;
  }

  .navbar__wordmark {
    letter-spacing: -0.01em;
  }

  .navbar__cta {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-5);
    background-color: var(--color-accent);
    color: var(--color-accent-fg);
    border-radius: var(--radius-button);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .navbar__cta:hover {
    background-color: var(--color-accent-hover);
  }
</style>
