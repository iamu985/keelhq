---
/**
 * AudienceSection — showcases the target personas for KeelHq.
 *
 * Responsibility:
 * - Render 6 audience role cards in a responsive CSS grid (2-col → 2-col → 3-col).
 */

interface AudienceCard {
  readonly icon: string;
  readonly role: string;
  readonly description: string;
}

const audience: readonly AudienceCard[] = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
    role: 'Founder',
    description: 'Ship a polished web presence without hiring a backend engineer.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    role: 'Developer',
    description: 'Focus on front-end craft. Let KeelHq own the backend plumbing.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
    role: 'Creator',
    description: 'Publish blog posts, galleries, and newsletters from a single dashboard.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    role: 'Influencer',
    description: 'Monetise your audience with forms, links, and exclusive content.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    role: 'Consultant',
    description: 'Impress clients with a professional site that actually works end-to-end.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72m2.54-15.38c-3.72 4.35-8.94 5.66-16.88 5.85m19.5 1.9c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32"/></svg>`,
    role: 'Artist',
    description: 'Display portfolios and sell work without touching a line of server code.',
  },
];
---

<section class="audience-section" aria-labelledby="audience-heading">
  <hr class="section-divider" />

  <div class="landing-section">
    <p class="section-label" data-reveal>Who It's For</p>
    <h2 id="audience-heading" class="section-title" data-reveal style="transition-delay: 80ms">
      Built for people who build in public.
    </h2>
    <p class="section-subtitle" data-reveal style="transition-delay: 160ms">
      Whether you're launching your first site or your tenth, KeelHq gives you a backend that's always ready.
    </p>

    <div class="audience-grid">
      {audience.map((card, index) => (
        <div
          class="audience-card"
          data-reveal
          style={`transition-delay: ${240 + index * 80}ms`}
        >
          <span class="audience-card__icon" set:html={card.icon} />
          <h3 class="audience-card__role">{card.role}</h3>
          <p class="audience-card__desc">{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .audience-section {
    background-color: var(--color-oatmeal);
  }

  .audience-grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-10);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 1024px) {
    .audience-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 640px) {
    .audience-card {
      padding: var(--space-6);
    }
  }

  .audience-card__icon {
    color: var(--color-accent);
    display: flex;
    align-items: center;
  }

  .audience-card__role {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .audience-card__desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }
</style>
