---
/**
 * WhyChooseSection — comparison of website builders, custom development, and KeelHq.
 *
 * Responsibility:
 * - Render three comparison cards in a responsive grid.
 * - Highlight KeelHq as the recommended choice.
 */

interface ChoiceCard {
  readonly title: string;
  readonly points: readonly string[];
  readonly highlighted?: boolean;
}

const choices: readonly ChoiceCard[] = [
  {
    title: 'Website Builders',
    points: ['Easy to start.', 'Hard to customize.', 'Limited by templates.'],
  },
  {
    title: 'Custom Development',
    points: ['Unlimited flexibility.', 'Requires backend development.', 'Ongoing maintenance.'],
  },
  {
    title: 'KeelHq',
    points: [
      'Generate any design with AI.',
      'Keep complete ownership of your site.',
      'Manage your content through KeelHq.',
      'Redesign whenever you want.',
    ],
    highlighted: true,
  },
];
---

<section class="why-section" aria-labelledby="why-heading">
  <hr class="section-divider" />

  <div class="landing-section">
    <p class="section-label" data-reveal>Why People Choose KeelHq</p>
    <h2 id="why-heading" class="section-title" data-reveal style="transition-delay: 80ms">
      Design freedom without backend headaches.
    </h2>

    <div class="why-grid">
      {choices.map((card, index) => (
        <div
          class={`why-card ${card.highlighted ? 'why-card--highlighted' : ''}`}
          data-reveal
          style={`transition-delay: ${160 + index * 80}ms`}
        >
          <h3 class="why-card__title">{card.title}</h3>
          <ul class="why-card__list">
            {card.points.map((point) => (
              <li class="why-card__item">{point}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-section {
    background-color: var(--color-bg);
  }

  .why-grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-10);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .why-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .why-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .why-card--highlighted {
    border: 2px solid var(--color-accent);
  }

  .why-card__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .why-card__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-5);
    list-style-type: disc;
  }

  .why-card__item {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }

  .why-card__item::marker {
    color: var(--color-accent);
  }
</style>
