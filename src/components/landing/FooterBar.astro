---
/**
 * FooterBar — minimal landing page footer.
 *
 * Responsibility:
 * - Render copyright notice and a "Built with AI" tagline.
 */
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner">
    <span class="footer__copy">&copy; 2025 Keel</span>
    <span class="footer__tagline">Built with AI</span>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-6);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }
</style>
