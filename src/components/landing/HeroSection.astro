---
/**
 * HeroSection — landing page hero with headline, CTAs, and workflow visual.
 *
 * Responsibility:
 * - Render the hero with a single responsive block using CSS media queries.
 * - Display animated glassmorphism workflow cards on wider viewports.
 */
---

<section class="hero-wrapper" aria-labelledby="hero-headline">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero landing-section">
    <div class="hero__content" data-reveal>
      <p class="section-label">AI-native infrastructure</p>
      <h1 id="hero-headline" class="hero__headline">
        Your AI builds the site.<br />KeelHq runs everything behind it.
      </h1>
      <p class="hero__subtext" data-reveal style="transition-delay: 100ms">
        Generate any personal website with AI. KeelHq handles the backend — content management, authentication, media storage, contact forms, and APIs.
      </p>
      <div class="hero__ctas" data-reveal style="transition-delay: 200ms">
        <a href="#waitlist" class="btn btn--primary" aria-label="Join the KeelHq waitlist">Join the Waitlist</a>
        <a href="#how-it-works" class="btn btn--ghost" aria-label="Learn how KeelHq works">See How It Works</a>
      </div>
    </div>

    <div class="hero__visual" data-reveal style="transition-delay: 400ms" aria-hidden="true">
      <div class="workflow">

        <!-- Card 1 -->
        <div class="workflow-card workflow-card--a">
          <span class="workflow-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
            </svg>
          </span>
          <span class="workflow-card__title">AI Coding Assistant</span>
        </div>

        <!-- Arrow between card 1 and 2 -->
        <div class="workflow-arrow workflow-arrow--h">
          <svg width="48" height="20" viewBox="0 0 48 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="0" y1="10" x2="40" y2="10" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="6 4" class="arrow-dash" />
            <polyline points="36,5 44,10 36,15" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
        </div>
        <div class="workflow-arrow workflow-arrow--v">
          <svg width="20" height="48" viewBox="0 0 20 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="10" y1="0" x2="10" y2="40" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="6 4" class="arrow-dash-v" />
            <polyline points="5,36 10,44 15,36" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
        </div>

        <!-- Card 2 -->
        <div class="workflow-card workflow-card--b">
          <span class="workflow-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="5" r="3" />
              <line x1="12" y1="8" x2="12" y2="21" />
              <path d="M5 15 C5 20 19 20 19 15" />
              <line x1="5" y1="15" x2="2" y2="15" />
              <line x1="19" y1="15" x2="22" y2="15" />
            </svg>
          </span>
          <span class="workflow-card__title">KeelHq</span>
        </div>

        <!-- Arrow between card 2 and 3 -->
        <div class="workflow-arrow workflow-arrow--h">
          <svg width="48" height="20" viewBox="0 0 48 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="0" y1="10" x2="40" y2="10" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="6 4" class="arrow-dash" />
            <polyline points="36,5 44,10 36,15" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
        </div>
        <div class="workflow-arrow workflow-arrow--v">
          <svg width="20" height="48" viewBox="0 0 20 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="10" y1="0" x2="10" y2="40" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="6 4" class="arrow-dash-v" />
            <polyline points="5,36 10,44 15,36" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
        </div>

        <!-- Card 3 -->
        <div class="workflow-card workflow-card--c">
          <span class="workflow-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          </span>
          <span class="workflow-card__title">Live Website</span>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Hero wrapper & glow ─────────────────────────────────────────── */

  .hero-wrapper {
    position: relative;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background: var(--gradient-hero-glow);
    animation: keel-glow-pulse 8s ease-in-out infinite alternate;
    pointer-events: none;
  }

  /* ─── Hero base (mobile-first: stacked column) ────────────────────── */

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-10);
    padding-top: 48px;
    padding-bottom: 48px;
    position: relative;
    text-align: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__headline {
    font-size: var(--font-size-hero);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-5);
  }

  .hero__subtext {
    font-size: var(--font-size-section-sub);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
    max-width: 52ch;
    margin-bottom: var(--space-8);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    width: 100%;
  }

  /* ─── Desktop (≥1024px): 2-col grid, left-aligned text ───────────── */

  @media (min-width: 1024px) {
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-12);
      padding-top: 80px;
      padding-bottom: 80px;
      text-align: left;
    }

    .hero__content {
      align-items: flex-start;
    }

    .hero__ctas {
      justify-content: flex-start;
      width: auto;
    }

    .hero__subtext {
      margin-bottom: var(--space-8);
    }

    .workflow-card--a {
      animation: keel-float-a var(--anim-float-a) ease-in-out infinite;
    }

    .workflow-card--b {
      animation: keel-float-b var(--anim-float-b) ease-in-out infinite;
    }

    .workflow-card--c {
      animation: keel-float-c var(--anim-float-c) ease-in-out infinite;
    }
  }

  /* ─── Buttons ─────────────────────────────────────────────────────── */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-button);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .btn--primary {
    background-color: var(--color-accent);
    color: var(--color-accent-fg);
  }

  .btn--primary:hover {
    background-color: var(--color-accent-hover);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-text-primary);
    border: 1.5px solid var(--color-border);
  }

  .btn--ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ─── Workflow visual ─────────────────────────────────────────────── */

  .hero__visual {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .hero__visual {
      justify-content: flex-end;
    }
  }

  /* ─── Mobile: vertical column ─────────────────────────────────────── */

  .workflow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* ─── Tablet+ (≥640px): horizontal row ───────────────────────────── */

  @media (min-width: 640px) {
    .workflow {
      flex-direction: row;
      align-items: center;
      gap: 0;
    }
  }

  /* ─── Cards ───────────────────────────────────────────────────────── */

  .workflow-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-card);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-card);
    min-width: 120px;
    text-align: center;
  }

  .workflow-card__icon {
    color: var(--color-accent);
    display: flex;
  }

  .workflow-card__title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    line-height: var(--line-height-tight);
  }

  /* ─── Arrows: vertical shown on mobile, horizontal on tablet+ ──────── */

  .workflow-arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile: show vertical arrow, hide horizontal */
  .workflow-arrow--h {
    display: none;
  }

  .workflow-arrow--v {
    display: flex;
  }

  /* Tablet+: show horizontal arrow, hide vertical */
  @media (min-width: 640px) {
    .workflow-arrow--h {
      display: flex;
    }

    .workflow-arrow--v {
      display: none;
    }
  }

  .arrow-dash {
    animation: keel-dash 1s linear infinite;
  }

  .arrow-dash-v {
    animation: keel-dash-v 1s linear infinite;
  }

  @keyframes keel-dash-v {
    to {
      stroke-dashoffset: -20;
    }
  }
</style>
