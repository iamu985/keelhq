---
/**
 * ProblemSection — highlights the backend challenges AI-built websites face.
 *
 * Responsibility:
 * - Render 6 problem cards in a responsive CSS grid (1-col → 2-col → 3-col).
 */

interface ProblemCard {
  readonly icon: string;
  readonly title: string;
  readonly description: string;
}

const problems: readonly ProblemCard[] = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>`,
    title: 'Databases',
    description: 'AI generates schemas but cannot provision, migrate, or maintain a live database.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>`,
    title: 'APIs',
    description: 'Dynamic data requires real endpoints — far beyond what a static export can offer.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`,
    title: 'Storage',
    description: 'Images, videos, and files need a CDN-backed bucket — not an AI-generated placeholder.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    title: 'Authentication',
    description: 'Protecting pages and user accounts requires real identity infrastructure, not mock code.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
    title: 'Contact Forms',
    description: 'Form submissions need a server to receive, validate, store, and forward messages.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
    title: 'Admin Dashboards',
    description: 'Managing your own content after launch requires a real CMS — not a rebuilt AI prompt.',
  },
];
---

<section class="problem-section" aria-labelledby="problem-heading">
  <hr class="section-divider" />

  <div class="landing-section">
    <p class="section-label" data-reveal>The Problem</p>
    <h2 id="problem-heading" class="section-title" data-reveal style="transition-delay: 80ms">
      AI can build websites.<br />It can't maintain them.
    </h2>
    <p class="section-subtitle" data-reveal style="transition-delay: 160ms">
      Every AI-generated site hits the same wall once it goes live. The code is there — the infrastructure isn't.
    </p>

    <div class="problem-grid">
      {problems.map((card, index) => (
        <div
          class="problem-card"
          data-reveal
          style={`transition-delay: ${240 + index * 80}ms`}
        >
          <span class="problem-card__icon" set:html={card.icon} />
          <h3 class="problem-card__title">{card.title}</h3>
          <p class="problem-card__desc">{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .problem-section {
    background-color: var(--color-bg);
  }

  .problem-grid {
    margin-top: var(--space-10);
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .problem-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .problem-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .problem-card {
    padding: var(--space-6);
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    border-left: 3px solid var(--color-accent);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .problem-card__icon {
    color: var(--color-accent);
    display: flex;
    align-items: center;
  }

  .problem-card__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .problem-card__desc {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }
</style>
