---
/**
 * ProblemSection — highlights the backend challenges AI-built websites face.
 *
 * Responsibility:
 * - Render 6 problem cards in a responsive CSS grid (1-col → 2-col → 3-col).
 */

interface ProblemCard {
  readonly icon: string;
  readonly title: string;
  readonly description: string;
}

const problems: readonly ProblemCard[] = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>`,
    title: 'Your content has to live somewhere.',
    description: 'Projects, services, blog posts, case studies, testimonials, and media all need to be stored and managed.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
    title: 'Visitors need a way to reach you.',
    description: 'Contact forms, inquiries, bookings, and leads do not work by themselves.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4L18.5 2.5z"/></svg>`,
    title: 'Updates should not require a developer.',
    description: 'Changing text, uploading images, or adding new content should not mean editing code every time.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
    title: 'Your website should not break when you redesign it.',
    description: 'Most websites tie content to design. Change the design and you often end up rebuilding everything.',
  },
];
---

<section class="problem-section" aria-labelledby="problem-heading">
  <hr class="section-divider" />

  <div class="landing-section">
    <p class="section-label" data-reveal>The Problem</p>
    <h2 id="problem-heading" class="section-title" data-reveal style="transition-delay: 80ms">
      AI can build websites.<br />It can't help you run one.
    </h2>
    <p class="section-subtitle" data-reveal style="transition-delay: 160ms">
      Today, creating a website is easier than ever. You can describe your idea to an AI and get a beautiful website in minutes. But once the design is finished, a new set of problems appears.
    </p>

    <div class="problem-grid">
      {problems.map((card, index) => (
        <div
          class="problem-card"
          data-reveal
          style={`transition-delay: ${240 + index * 80}ms`}
        >
          <span class="problem-card__icon" set:html={card.icon} />
          <h3 class="problem-card__title">{card.title}</h3>
          <p class="problem-card__desc">{card.description}</p>
        </div>
      ))}
    </div>

    <p class="problem-closing" data-reveal style="transition-delay: 560ms">
      AI helps you create the website. KeelHq helps you keep it alive.
    </p>
  </div>
</section>

<style>
  .problem-section {
    background-color: var(--color-bg);
  }

  .problem-grid {
    margin-top: var(--space-10);
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .problem-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .problem-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .problem-card {
    padding: var(--space-6);
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    border-left: 3px solid var(--color-accent);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .problem-card__icon {
    color: var(--color-accent);
    display: flex;
    align-items: center;
  }

  .problem-card__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .problem-card__desc {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }

  .problem-closing {
    margin-top: var(--space-10);
    font-size: var(--font-size-section-sub);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    text-align: center;
  }
</style>
